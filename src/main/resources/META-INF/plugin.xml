<idea-plugin>
    <id>WGSL</id>
    <name>WGSL Support</name>
    <vendor>dparnell</vendor>
    <category>Custom Languages</category>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>com.intellij.modules.ultimate</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="WGSL File" implementationClass="wgslplugin.WgslFileType" fieldName="WGSL" extensions="wgsl"/>
        <fileType name="WESL File" implementationClass="wgslplugin.WgslFileType" fieldName="WESL" extensions="wesl"/>
        <textmate.bundleProvider implementation="wgslplugin.WgslTextMateBundleProvider"/>
        <platform.lsp.integrationProvider implementation="wgslplugin.WgslLspIntegrationProvider"/>
        <projectConfigurable parentId="language" instance="wgslplugin.WgslSettingsConfigurable"
                             id="wgsl.languageServer" displayName="WGSL / WESL"/>
    </extensions>
</idea-plugin>
