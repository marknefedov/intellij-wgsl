<idea-plugin>
    <id>WGSL_WESL</id>
    <name>WGSL / WESL</name>
    <vendor>mark_nefedov</vendor>
    <category>Custom Languages</category>
    <depends>com.intellij.modules.lang</depends>
    <depends>com.intellij.modules.lsp</depends>
    <depends>org.jetbrains.plugins.textmate</depends>
    <extensions defaultExtensionNs="com.intellij">
        <fileType name="WGSL File" implementationClass="wgslplugin.WgslFileType" extensions="wgsl"/>
        <fileType name="WESL File" implementationClass="wgslplugin.WeslFileType" extensions="wesl"/>
        <textmate.bundleProvider implementation="wgslplugin.WgslTextMateBundleProvider"/>
        <lang.syntaxHighlighterFactory language="textmate" implementationClass="wgslplugin.WgslSyntaxHighlighterFactory" order="first"/>
        <colorSettingsPage implementation="wgslplugin.WgslColorSettingsPage"/>
        <additionalTextAttributes scheme="Default" file="colorSchemes/WgslDefault.xml"/>
        <additionalTextAttributes scheme="Darcula" file="colorSchemes/WgslDarcula.xml"/>
        <platform.lsp.integrationProvider implementation="wgslplugin.WgslLspIntegrationProvider"/>
        <projectConfigurable parentId="language" instance="wgslplugin.WgslSettingsConfigurable"
                             id="wgsl.languageServer" bundle="messages.WgslBundle" key="settings.displayName"/>
    </extensions>
</idea-plugin>
